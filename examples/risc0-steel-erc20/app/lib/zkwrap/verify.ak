test claim_digest_chain_matches() {
  risc0.compute_claim_digest_from_journal(
    #"",
    image_id,
    post_state_digest,
  ) == #"3a1d568becc49a517a12d964fad0916fb662687d7fd84a9692fc5656913062f5"
}

test risc0_inputs_match_proof() {
  risc0.real_inputs(
    #"",
    control_root_0,
    control_root_1,
    image_id,
    post_state_digest,
    bn254_control_id,
  ) == [0x0000000000000000000000000000000041af18736dc9d7921c859fc95ac84da5, 0x00000000000000000000000000000000561f8c992a424deb37ccdf4e19c0e7db, 0x000000000000000000000000000000006f91d0fa64d9127a519ac4ec8b561d3a, 0x00000000000000000000000000000000f56230915656fc92964ad87f7d6862b6, 0x04446e66d300eb7fb45c9726bb53c793dda407a62e9601618bb43c5c14657ac0]
}

